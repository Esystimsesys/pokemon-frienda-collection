# 公式サイトから取得した生HTML・画像。fetch_official.py / OCRスクリプトの入力で、再取得可能。
# 「scripts/raw/」とディレクトリごと書くと git が中を見に行かず、下の「!」が効かなくなる。
# 中身を除外する書き方（末尾の *）にすること。
scripts/raw/*

# ただしOCRの読み取り結果は picks.json の元になるので残す。
# 214MBの画像を持っていない環境でも build:data が正しく通るようにするため。
!scripts/raw/ocr_stats.json
!scripts/raw/ocr_header.json
!scripts/raw/ocr_moves.json
!scripts/raw/ocr_extra.json
!scripts/raw/ocr_special.json
# 人が手で入れたぶん。作り直せないので必ず残す
!scripts/raw/manual.json

# ファンサイトから取り込んだポケエネ/すばやさも同じ理由で残す。
!scripts/raw/pokearcade.json

# 旧ファンサイト由来のデータ。もう取得できないうえ、parse_official.py の入力なので必ず残す
!scripts/raw/legacy_picks.json

# swiftc でビルドしたOCRツール（再ビルド可能なのでコミットしない）
scripts/ocr/build/

__pycache__/

